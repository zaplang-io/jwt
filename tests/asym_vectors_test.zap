# Generated by tools/generate-asym-vectors.py (OpenSSL is the independent signer).
# RS256/EdDSA are deterministic known-answer tests; ES256 uses a random nonce
# so only external-sign->Zap-verify and the self round-trip are asserted.
import jwt

def main():
    # ---- RS256: external sign -> Zap verify (direct PEM public key) ----
    auto rs256_pub = bytes(
        "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAsSdYkejF68K4WZPxkq01\n3RvHXeUCMtkgtFoKiM6GOuCAc9b50FIYLNo+tqfZjnrK3+fokP8kRAN1DYeUxg8d\nuAiHjpDxh8xmOQP1vlYm5nKKmTy1VEu1ndufb0oefznGt+PqdSIrIQhdPlkbiuwv\noCntElCkD4opsGH9TthlU0f7O/Y6TSSm1yAKvBFXttv4qPxaSrdG0xDDEO/rMpjn\nu/Zxn05AaEXXLeu+MhDgyIEmybHVYhNPB7DkZvmQuVMNh9dAuQni+NlqQWNNNl4x\naJJLecwWzZl+ahg4RWGq6IpjuihTBAuxTi5rKHug2pYfwgVoAidPKPT0qLZ6WTkN\nYwIDAQAB\n-----END PUBLIC KEY-----\n",
    )
    auto rs256_token = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.BONtUAIkHOyZSAHXVg1-mclBxmTwafgyrTrie3nBG-HvVJ15SOloX-8138xOcWNjgRqIk7SXyiNveVrOV2nptT4njLdSmZODNMNcFE9TW5Ewo5IRTobVLUblUAhLi7VTlUK2DfQ5QVq9Qs3sfSSdl0-X37k7KD6SjqiqKvp0hvrxCmJQxNHMvt_QgxcnSG6lyhAGjCpPZ38_8mhBe8IXbRxjj6j3mvAHh-GQwdJAC8lS7pnZPVVCJ-dDMsouQ8xqsP_JtXl1dNjfe-T3V20GjPyKw2PE1l3OnqdIbuFR-MqO4yeHLJYIs3JkKc4XE1wJk6pwhycPOhEh_aVB0WZykQ"
    auto rs256_v = jwt.verify_signature(rs256_token, rs256_pub, "RS256")
    assert json.dumps(rs256_v.claims["sub"]) == "\"alice\""
    assert json.dumps(rs256_v.claims["iss"]) == "\"issuer\""
    # ---- RS256: external sign -> Zap verify via public JWK ----
    auto rs256_jwk = "{\"kty\":\"RSA\",\"alg\":\"RS256\",\"kid\":\"rs256-1\",\"n\":\"sSdYkejF68K4WZPxkq013RvHXeUCMtkgtFoKiM6GOuCAc9b50FIYLNo-tqfZjnrK3-fokP8kRAN1DYeUxg8duAiHjpDxh8xmOQP1vlYm5nKKmTy1VEu1ndufb0oefznGt-PqdSIrIQhdPlkbiuwvoCntElCkD4opsGH9TthlU0f7O_Y6TSSm1yAKvBFXttv4qPxaSrdG0xDDEO_rMpjnu_Zxn05AaEXXLeu-MhDgyIEmybHVYhNPB7DkZvmQuVMNh9dAuQni-NlqQWNNNl4xaJJLecwWzZl-ahg4RWGq6IpjuihTBAuxTi5rKHug2pYfwgVoAidPKPT0qLZ6WTkNYw\",\"e\":\"AQAB\",\"use\":\"sig\"}"
    auto rs256_key = jwt.load_jwk(rs256_jwk)
    assert rs256_key.can_verify and not rs256_key.can_sign
    auto rs256_set = jwt.KeySet([rs256_key])
    auto rs256_kv = jwt.verify_keyset_signature(
        "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InJzMjU2LTEifQ.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.Bh7J-DUCej3mOalphwe8wV3jfk3WzAPC7gePgiOrXB1ivvhGCiAQkO1_hJhDVkYFwWjvbDcHnlXB4avoSEzliWzd6jDd-seE5GnJbgVQNq-Us-3dICwqpVlkN2D-59TPr_c6KWi3895tC4Uxs6pBUvcNY9P3a0U0N4Kfw7oVGYLbHTY4QdhEfzLXhWQ7P2DeE9wTZ3AqRwkv1_x1BjIHQ97Pufl4qGbI94k1BH7PYvSabN2-ZufpOPcOadg0dEw1NNweQT2EM5D5gO4u47HPUx3hWx7AOINLjCJTNx9UQorPk_KtoePAID34HjTV2PbtO4ewewtXrAwXDLm12c_-8w",
        rs256_set,
        ["RS256"],
    )
    assert json.dumps(rs256_kv.claims["sub"]) == "\"alice\""
    # ---- ES256: external sign -> Zap verify (direct PEM public key) ----
    auto es256_pub = bytes(
        "-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEbuzdMRSEeTuBrXQyVHK5xWDSzla1\nYeQlecY0Bh9rqfxmO1qUOFgZYvwK4yLfgnqEBbTMzPSmiBaIAdmRqTsyhg==\n-----END PUBLIC KEY-----\n",
    )
    auto es256_token = "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.TqQi68UURtOufQar-EjajNk4L2kD55TKot32-2MxZFc4QtpFz7j-_3BsdqBHYuCvwVsmcYVvE5GGrhrGJOzsJQ"
    auto es256_v = jwt.verify_signature(es256_token, es256_pub, "ES256")
    assert json.dumps(es256_v.claims["sub"]) == "\"alice\""
    assert json.dumps(es256_v.claims["iss"]) == "\"issuer\""
    # ---- ES256: external sign -> Zap verify via public JWK ----
    auto es256_jwk = "{\"kty\":\"EC\",\"alg\":\"ES256\",\"kid\":\"es256-1\",\"crv\":\"P-256\",\"x\":\"buzdMRSEeTuBrXQyVHK5xWDSzla1YeQlecY0Bh9rqfw\",\"y\":\"ZjtalDhYGWL8CuMi34J6hAW0zMz0pogWiAHZkak7MoY\",\"use\":\"sig\"}"
    auto es256_key = jwt.load_jwk(es256_jwk)
    assert es256_key.can_verify and not es256_key.can_sign
    auto es256_set = jwt.KeySet([es256_key])
    auto es256_kv = jwt.verify_keyset_signature(
        "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImVzMjU2LTEifQ.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.717plXjqnXJm2NRliYpZTom410yuTjjI5wzMnYcIXka_SZMHdav5l9gCIOuflKcNZ6GiK8NuapP9LeQZ_itflw",
        es256_set,
        ["ES256"],
    )
    assert json.dumps(es256_kv.claims["sub"]) == "\"alice\""
    # ---- EdDSA: external sign -> Zap verify (direct PEM public key) ----
    auto eddsa_pub = bytes(
        "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAo8QjCOnUT+j/qtpX++u3z1Ejbf2UnNq9D41qXPEgcQs=\n-----END PUBLIC KEY-----\n",
    )
    auto eddsa_token = "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.gIip3tzqZJhm-8MlbW_NBsRa32nC8iNf3GBn1A7kg37LGxl6LRlONhMBlqvp5dQ6YhJBqkkLd0aPwIJBhhH7Bg"
    auto eddsa_v = jwt.verify_signature(eddsa_token, eddsa_pub, "EdDSA")
    assert json.dumps(eddsa_v.claims["sub"]) == "\"alice\""
    assert json.dumps(eddsa_v.claims["iss"]) == "\"issuer\""
    # ---- EdDSA: external sign -> Zap verify via public JWK ----
    auto eddsa_jwk = "{\"kty\":\"OKP\",\"alg\":\"EdDSA\",\"kid\":\"eddsa-1\",\"crv\":\"Ed25519\",\"x\":\"o8QjCOnUT-j_qtpX--u3z1Ejbf2UnNq9D41qXPEgcQs\",\"use\":\"sig\"}"
    auto eddsa_key = jwt.load_jwk(eddsa_jwk)
    assert eddsa_key.can_verify and not eddsa_key.can_sign
    auto eddsa_set = jwt.KeySet([eddsa_key])
    auto eddsa_kv = jwt.verify_keyset_signature(
        "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCIsImtpZCI6ImVkZHNhLTEifQ.eyJzdWIiOiJhbGljZSIsImlzcyI6Imlzc3VlciJ9.nlRS-93b8WM0IDLNZhxJ9np-1_BZf16Ay5cntp4dIGGejdpyPn-6c5i17xz8cq5Crn8QmXmB5ScuIhQq9lkPDg",
        eddsa_set,
        ["EdDSA"],
    )
    assert json.dumps(eddsa_kv.claims["sub"]) == "\"alice\""
    # ---- RS256: Zap sign -> external known-answer (deterministic) ----
    auto rs256_priv = bytes(
        "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCxJ1iR6MXrwrhZ\nk/GSrTXdG8dd5QIy2SC0WgqIzoY64IBz1vnQUhgs2j62p9mOesrf5+iQ/yREA3UN\nh5TGDx24CIeOkPGHzGY5A/W+VibmcoqZPLVUS7Wd259vSh5/Oca34+p1IishCF0+\nWRuK7C+gKe0SUKQPiimwYf1O2GVTR/s79jpNJKbXIAq8EVe22/io/FpKt0bTEMMQ\n7+symOe79nGfTkBoRdct674yEODIgSbJsdViE08HsORm+ZC5Uw2H10C5CeL42WpB\nY002XjFokkt5zBbNmX5qGDhFYaroimO6KFMEC7FOLmsoe6Dalh/CBWgCJ08o9PSo\ntnpZOQ1jAgMBAAECggEAUakzeL72TUFLPW+nEdfqVmwxsKSaKNpR6xD+fiXFVmqa\ni8tzCIZvQm2wLv6cmMMdtazvVbdm/jshwATZnZrmNikoY52I2PJtxKaApyaLc/sk\nzJJhe+QSahwNGH3wJPF7GtVjBG+ltepnIRBuU9Gf+pKZB7JIjilAImBpJek2e/aU\nB6Spv6v5NcChu1ObCTWo6sySRMqLfJGodzptMSdhrxWRaEY5wMrrtD1x/zoK6FyT\nK6+i78lgCFX2F9M+kvXeQ398jLhrnIeQ5tMlfGCLgnhorm3P6AqZXxjCXHWEJUlE\njmZStUM/CWNbesJrakh8XQn334vOAuBEDa4G4XThUQKBgQDZNofA4ec1kIFB07++\nyMGSkeaShZudioGquxAT4CKixcgpjum25dMcgBj+DXEOShrkBZtuimqeuWA6rEM5\nGOgWUoL5OR/jmQ7rZA3DD+0+bG6/tkca2uBZ2imutJqXxXBuNI46/20RiGnvF23Q\n3RSgfbVoy2FcIsN1p9L4SV1UTQKBgQDQyZUJRV0PXpG0jaKsdtnTYlay/z/2Ks4z\nZNlQAzmfSms48p4+tZMc2V60lC0INzAvAJoiLIPctlNAnpWLYlmzwrHiA1rRWivV\nOnroTO4Pe59kdEQsDEJ18wJE+8WHAQYdQDnnhCu/cWnw3xeOXI0eNaH3gbhcWbX8\n6S1/l4eAbwKBgEbrrQtnNuygT/PERXjvZ3SJurTgdtzLWmb6SNeUePqYhTA8f0a+\nZ12I3aAll2JJA9qrkgJXo1RLxoWhtRkxbqXLLwRciHLxiJOGyY+E5btaABcMVs8H\n4/SybKWkRk2Do5/3/PB6cYwl9CCij7KAXLnCEbczoIhKuXLy5sk2ewiJAoGBAL+X\nK68dOp8+7b/cdNmEGrESPXL2LdCMSTn6Ijx9KSRWGvxgDvyGjJ/djD1y97vhQNLw\n33/aj4o6uTzECYClWKFPWQKIh48zCqQZjO2copwMmiCJXIF7IoWv4HZC/2i6dMzk\nwf4EWEzOGyRQ5AHcRhbhqmZAYFhGbmzN4NWDzHD7AoGBAKzVG+OxTZCVw9wS1quK\nYxMfiOJj13RdH/tNfDUBJ7briGU1qeagXqNU72woYXEQEUBL7sXIMioAetlYETZ/\nRH9BnZn4ynSPT0M0WfsjP5R+1FDOuKkHyc9p+OqyLlMxvJFeNlqaaATI4ThX4Zw1\nl1ue3SOskTegrovHAZjtHDfv\n-----END PRIVATE KEY-----\n",
    )
    auto rs256_enc = jwt.encode({"sub": JsonValue.Str("alice")}, rs256_priv, "RS256")
    assert rs256_enc == "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSJ9.m7LEzNHFX8gttGyGPDxjfUOxR0qB8UNHdFSPqX1CO__z6QqMEvaaXDvXQrQE8MMqKpu-p8WlbEJ9kmi0vZVTf9wvvbQyd5ZEA10EutCwsXkwhregxyMaDeYEOrznafHP1gjI8SqvQGJgpnNDC_6RG164wP_3pJ0grT-ye971nR1o_YDvaXE682LrmA3fZ3gVmz8l1VnxxCOnZRtydZbJDXJWMKwdyU5j9MfhQy6Dyntx8Yv7GQjD5xFJ2MdXwnmXMa1SAI5u8Gup7Ie78SV0lutxyHjWx0u9w6PDcEfuKgmE-53DRpZKSRZh1mx4WbGdgNsDobaphKUpd9xDvwH7mQ" or rs256_enc == "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJhbGljZSJ9.AasoQ_gn6NqNGwWcnWEHvrh0GoEW9IqnpIWb0IKPZxjihZgTE3cwlJ-wYloDoyxv2-L8CsAh7YAuAxYvVn0TzXNUI_e1NDRCX-r8845u96bUftMlRiY5k39sPsaaQXUTUoY6-WjGgWsjYAKvfbtlHDWMv4ph_m-6LlMKs9OM-mGqA53Iq6aiSd7PCRDn0qi7MpDGYJRPWjnuQ8OereBphKufIcOpyl5YzR3Y3zpCqmVt3ERT-2WcVGe0d8-JgJyTpADP8Q9fSGfhE8hybAqn7jB9GHNjeLHVRt5ni1xDb2B0ngNvuygG8pGK83W6ZaOcJnRFplFsMektY3lwps4wgw"
    jwt.verify_signature(rs256_enc, rs256_pub, "RS256")
    # ---- EdDSA: Zap sign -> external known-answer (deterministic) ----
    auto eddsa_priv = bytes(
        "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIPir7sSo5wp44H0Bp9w9l2n6j4JYKmBuOe1RbMdaXd2D\n-----END PRIVATE KEY-----\n",
    )
    auto eddsa_enc = jwt.encode({"sub": JsonValue.Str("alice")}, eddsa_priv, "EdDSA")
    assert eddsa_enc == "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSJ9.uOVVoNX1TE74k7Mj2NpfKab7En1_FWxy1-f0QaHMb2X6uI358r9sq6_4jlaBOi_3LlE4YlD91wJNS9bkHIMFDQ" or eddsa_enc == "eyJ0eXAiOiJKV1QiLCJhbGciOiJFZERTQSJ9.eyJzdWIiOiJhbGljZSJ9.mh0RGsWgIQBhoTXxjhfr7kIPQM2dwkM1jQ7qsTWCP7bRESTKWyb63oNWgwTMknvecKlO32t3vwTjkgLVVGL3CA"
    jwt.verify_signature(eddsa_enc, eddsa_pub, "EdDSA")
    # ---- ES256: Zap sign -> Zap verify round-trip; canonical 64-byte JOSE ----
    auto es_priv = bytes(
        "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgOdnFeCJxVc6WZ+Yh\nFqkLg2bhJ9Bo3wYHbK8PoHPF2vChRANCAARu7N0xFIR5O4GtdDJUcrnFYNLOVrVh\n5CV5xjQGH2up/GY7WpQ4WBli/ArjIt+CeoQFtMzM9KaIFogB2ZGpOzKG\n-----END PRIVATE KEY-----\n",
    )
    auto es_rt = jwt.encode({"sub": JsonValue.Str("alice")}, es_priv, "ES256")
    auto es_rtv = jwt.verify_signature(es_rt, es256_pub, "ES256")
    assert json.dumps(es_rtv.claims["sub"]) == "\"alice\""
    assert len(es_rt.split(".")[2]) == 86
    print("asymmetric interop vectors: PASS")
